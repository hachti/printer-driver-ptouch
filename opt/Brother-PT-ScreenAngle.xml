<option type="enum" id="opt/Brother-PT-ScreenAngle">
  <arg_longname>
    <en>Screen angle (halftone only)</en>
  </arg_longname>
  <arg_shortname>
    <en>ScreenAngle</en>
  </arg_shortname>
  <arg_execution>
    <arg_group>ImageQualityPage</arg_group>
    <arg_order>120</arg_order>
    <arg_spot>A</arg_spot>
    <arg_postscript />
    <arg_proto>%s</arg_proto>
  </arg_execution>
  <constraints>
    <constraint sense="true">
      <driver>ptouch-pt</driver>
      <arg_defval>ev/Default</arg_defval>
    </constraint>
    <constraint sense="false">
      <driver>ptouch-ql</driver>
    </constraint>
  </constraints>
  <enum_vals>
    <enum_val id="ev/Default">
      <ev_longname>
        <en>Ghostscript default</en>

        <en>0 degrees</en>
      </ev_longname>
      <ev_shortname>
        <en>Deg0</en>
      </ev_shortname>
      <ev_driverval>currentscreen exch pop 0 exch setscreen</ev_driverval>
    </enum_val>
    <enum_val id="ev/Deg15">
      <ev_longname>
